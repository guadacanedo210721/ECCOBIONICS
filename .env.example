# FRONTEND
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=ECCOBIONICS

# BACKEND
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eccobionics
REDIS_URL=redis://localhost:6379
